# Optional: Override Keycloak URL for browser access (e.g. when Keycloak runs in Docker but browser is on host)
# VITE_KEYCLOAK_BROWSER_URL=http://localhost:8180

# Where docker compose finds the portal dumps the acceptance run seeds from. Defaults to ./dumps,
# which is gitignored; the header above portal-db-cnet in docker-compose.yaml says how to fetch one.
# PORTAL_DUMPS_DIR=/home/you/portal-dumps
